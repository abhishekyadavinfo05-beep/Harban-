# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Server-side only for service_role; never expose secret keys in frontend)
SUPABASE_URL="https://yynubnoijafkzcengteb.supabase.co"
SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# ADMIN ACCESS (Comma-separated email allowlist for authorized administrators)
ADMIN_EMAILS="abhishekyadavinfo05@gmail.com,harban.official@gmail.com"

# RAZORPAY PAYMENT GATEWAY (Server-side only; Test Mode enabled by default)
RAZORPAY_ENABLED="true"
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# FIREBASE HOSTING / STATIC FRONTEND (Optional overrides when deployed on Firebase Hosting)
